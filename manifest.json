{
    "manifest_version": 3,
    "name": "WebsiteMasterControls",
    "version": "0.1.0",
    "permissions": ["tabs", "activeTab", "scripting", "microphone", "storage"],
    "host_permissions": ["<all_urls>"],
    "content_scripts": [
        {
            "matches": ["<all_urls>"],
            "js": ["content.js"]
        }
    ],
    "action": {
        "default_popup": "popup.html",
        "default_title": "Website Master Controls",
        "default_icon": "images/icon.png"
    },
    "background": {
        "service_worker": "background.js"
    }
}